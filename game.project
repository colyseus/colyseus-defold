[project]
title = Colyseus Defold SDK
version = 0.17
dependencies#0 = https://github.com/defold/extension-websocket/archive/refs/tags/4.2.1.zip
dependencies#1 = https://github.com/britzl/deftest/archive/refs/tags/2.8.0.zip
dependencies#2 = https://github.com/Insality/druid/archive/refs/tags/1.1.6.zip
dependencies#3 = https://github.com/Insality/defold-event/archive/refs/tags/12.zip

[bootstrap]
main_collection = /example/main.collectionc

[display]
width = 1280
height = 720

[script]
shared_state = 1

[library]
include_dirs = colyseus

[websocket]
max_connections = 4

